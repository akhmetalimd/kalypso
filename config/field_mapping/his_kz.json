{
  "_comment": "ЧЕРНОВИК маппинга his.kz -> регистр (PRD §6.3). Пути полей источника (path) — ЗАГЛУШКИ: реальная схема API his.kz неизвестна и заполняется по спецификации поставщика (см. docs/hiskz_integration_questions.md). Принцип — белый список: в регистр проходят только описанные здесь поля; ФИО, адрес, телефон и прочее отбрасываются. ИИН используется только для HMAC-хэша.",
  "version": "his_kz-draft-2026-10",
  "source_system": "his.kz",
  "identity": { "iin": "patient.iin", "record_id": "id" },
  "inclusion": { "diagnoses_path": "diagnoses", "code_field": "icd10", "codes": ["C91.1", "C83.0"] },
  "patient": {
    "sex":               { "path": "patient.gender", "map": { "М": "M", "Ж": "F", "1": "M", "2": "F" }, "required": true },
    "birth_date":        { "path": "patient.birthDate", "type": "date" },
    "branch":            { "path": "patient.facilityCode", "lookup": "facilities", "required": true },
    "last_contact_date": { "path": "patient.lastVisitDate", "type": "date", "required": true }
  },
  "diagnosis": {
    "mkb":       { "path": "icd10", "required": true },
    "who_haem5": { "path": "icd10", "lookup": "mkb_to_who", "required": true },
    "icd_o_3_2": { "path": "icd10", "lookup": "mkb_to_icdo", "required": true },
    "dx_date":   { "path": "date", "type": "date", "required": true }
  },
  "lab": {
    "loinc":    { "path": "code", "lookup": "lab_codes", "required": true },
    "value":    { "path": "value", "type": "number", "required": true },
    "unit":     { "path": "unit", "lookup": "units", "required": true },
    "obs_date": { "path": "date", "type": "date", "required": true }
  },
  "document": {
    "doc_type": { "path": "type", "lookup": "doc_types", "required": true },
    "doc_date": { "path": "date", "type": "date", "required": true },
    "text":     { "path": "text", "type": "text", "deid": true, "required": true }
  },
  "lookups": {
    "facilities": { "F-ALM-01": "synth_a", "F-AST-02": "synth_b", "F-SHY-03": "synth_c" },
    "mkb_to_who": { "C91.1": "cll_sll", "C83.0": "cll_sll" },
    "mkb_to_icdo": { "C91.1": "9823/3", "C83.0": "9670/3" },
    "lab_codes": { "HGB": "8302-2", "WBC": "6690-2", "LYM#": "731-0", "NEU#": "751-8", "PLT": "777-3",
                   "LDH": "2532-0", "B2M": "1952-1", "CREA": "2160-0", "TBIL": "1975-2", "UA": "3084-1", "GLU": "2345-7" },
    "units": { "г/л": "g/L", "г/дл": "g/dL", "10^9/л": "10*9/L", "10*9/л": "10*9/L", "тыс/мкл": "10*3/uL",
               "мг/л": "mg/L", "мкг/мл": "ug/mL", "ед/л": "U/L", "Ед/л": "U/L", "мкмоль/л": "umol/L",
               "мг/дл": "mg/dL", "ммоль/л": "mmol/L" },
    "doc_types": { "HIST": "histology", "FISH": "cytogenetics", "MOLEC": "molecular", "PET": "pet_ct" }
  }
}
