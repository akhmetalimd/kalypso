# Скопируйте в deploy/.env и заполните:  cp .env.example .env && chmod 600 .env
# Каждое значение — случайная строка:   openssl rand -hex 32
# (hex — без символов, которые ломают строку подключения). Файл .env в git не попадает.

# Суперпользователь PostgreSQL (служебный: инициализация, резервные копии)
POSTGRES_PASSWORD=
# Владелец схемы: применяет миграции (сервис migrate)
KALYPSO_OWNER_PASSWORD=
# Логин приложения: роль kalypso_app, подчиняется RLS
KALYPSO_WEB_PASSWORD=
# Секрет CSRF-токенов, не короче 32 символов. Смена — выход всех пользователей.
KALYPSO_SESSION_SECRET=
# Срок сессии, часов
KALYPSO_SESSION_HOURS=8
